# Copy to apps/dashboard/.env.local and fill in the blanks.

# Postgres — the same database the API uses (sign-in/sign-up live here).
DATABASE_URL=postgres://pocketstrip:pocketstrip@localhost:5432/pocketstrip

# MUST be identical to BETTER_AUTH_SECRET in apps/api/.env.local.
BETTER_AUTH_SECRET=

# This dashboard's own URL.
BETTER_AUTH_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Where the API runs.
NEXT_PUBLIC_API_URL=http://localhost:4000
