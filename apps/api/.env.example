# Copy to apps/api/.env.local and fill in the blanks.

# Postgres — the same database the dashboard uses.
DATABASE_URL=postgres://pocketstrip:pocketstrip@localhost:5432/pocketstrip

# Shared auth secret. MUST be identical in apps/dashboard/.env.local.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where the dashboard runs (auth cookies, CORS, checkout redirects, portal links).
BETTER_AUTH_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Public URL of this API. Shown in Settings as the webhook endpoint.
API_URL=http://localhost:4000
PORT=4000

# Encrypts merchants' payment provider keys at rest. 32+ random characters.
# Generate one with: openssl rand -base64 32
# Don't change it after connecting providers, or stored keys can't be decrypted.
PROVIDERS_MASTER_KEY=
